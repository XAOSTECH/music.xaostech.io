---
export interface Props {
  post: {
    id: string;
    title: string;
    slug: string;
    excerpt?: string;
    artist?: string;
    album?: string;
    genre?: string;
    cover_image_url?: string;
    published_at?: number;
    author_name?: string;
    author_avatar?: string;
  };
}

const { post } = Astro.props;

const formatDate = (timestamp?: number) => {
  if (!timestamp) return '';
  return new Date(timestamp * 1000).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<article class="trove-card card">
  <a href={`/trove/${post.slug}`} class="trove-link">
    {post.cover_image_url && (
      <img src={post.cover_image_url} alt={post.title} class="cover-image" />
    )}
    <div class="trove-content">
      <h2>{post.title}</h2>
      {(post.artist || post.album) && (
        <div class="music-meta">
          {post.artist && <span class="artist">{post.artist}</span>}
          {post.artist && post.album && <span class="sep">&mdash;</span>}
          {post.album && <span class="album">{post.album}</span>}
        </div>
      )}
      {post.genre && <span class="genre-tag">{post.genre}</span>}
      {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
      <div class="post-meta">
        <div class="author">
          <img 
            src={post.author_avatar || '/favicon.png'} 
            alt={post.author_name || 'Author'} 
            class="author-avatar"
          />
          <span>{post.author_name || 'Author'}</span>
        </div>
        <time>{formatDate(post.published_at)}</time>
      </div>
    </div>
  </a>
</article>

<style>
  .trove-card {
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .trove-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(246, 130, 31, 0.1);
  }
  
  .trove-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  
  .trove-link:hover {
    text-decoration: none;
  }
  
  .trove-link:hover h2 {
    color: var(--primary);
  }
  
  .cover-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  
  .trove-content {
    padding: 1.25rem;
  }
  
  .trove-content h2 {
    margin-bottom: 0.4rem;
    font-size: 1.25rem;
    transition: color 0.2s;
  }
  
  .music-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }
  
  .sep {
    opacity: 0.5;
  }
  
  .genre-tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(246, 130, 31, 0.15);
    color: var(--primary);
    margin-bottom: 0.5rem;
  }
  
  .excerpt {
    opacity: 0.7;
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    opacity: 0.6;
    font-size: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  
  .author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .author-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }
  
  time {
    white-space: nowrap;
  }
  
  @media (min-width: 600px) {
    .trove-link {
      flex-direction: row;
    }
    
    .cover-image {
      width: 200px;
      height: auto;
      min-height: 160px;
    }
  }
</style>
